# KalaiPaalam AI Environment Configuration
# SIH26090 • Heritage & Culture

# Set DEMO_MODE to true for reliable presentation without external API dependencies
DEMO_MODE=true

# Database Configuration (PostgreSQL in production, SQLite default for local zero-dependency run)
DATABASE_URL=sqlite:///./kalai_paalam.db
# DATABASE_URL=postgresql://user:password@localhost:5432/kalaipaalam

# Redis Caching & Asynchronous Queue
REDIS_URL=redis://localhost:6379/0

# Bhashini Vernacular Speech & Translation API
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# AI & LLM Inference API
AI_API_KEY=

# Marketplace API Vault References (Stored server-side, never exposed to client)
